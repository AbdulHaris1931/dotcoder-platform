# ==============================================================================
# EQLV CODE PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables
# directly into your deployment environment (Vercel, Netlify, Railway, or Docker).
#
# NOTE: Zero-Crash Graceful Degradation is built-in. If Supabase or Gemini keys
# are omitted, the application seamlessly runs in Local Demo Mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Mandatory for Live Cloud Database)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Mandatory for server-side Super Admin user provisioning (/api/super-admin/users):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Engine (Mandatory for AI Mentor, Exam Gen & CSV Parser)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. Super Admin Enclave Identity
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@yourinstitution.edu
SUPER_ADMIN_USER_ID=usr-super-admin-root
SUPER_ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Recommended for Multi-Instance Vercel/Serverless)
# ------------------------------------------------------------------------------
# Falls back cleanly to in-memory sliding window when omitted:
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ------------------------------------------------------------------------------
# 5. Transactional Welcome Emails (Optional via Resend)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="EQLV CODE <onboarding@yourdomain.edu>"

# ------------------------------------------------------------------------------
# 6. Optional External Code Compilation (Default: Pyodide Client-side WASM)
# ------------------------------------------------------------------------------
# ONLINECOMPILER_API_KEY=your_key_here
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
